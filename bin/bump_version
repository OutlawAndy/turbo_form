#!/usr/bin/env ruby

require 'bundler/setup'
require 'turbo_form/version'
require 'rake/file_list'
require 'thor'

class VersionBumper < Thor::Group
  include Thor::Actions

  class_exclusive do
    class_option :patch, type: :boolean, lazy_default: false, desc: 'Bump patch version instead of minor version'
    class_option :major, type: :boolean, lazy_default: false, desc: 'Bump major version instead of minor version'
    class_option :minor, type: :boolean, lazy_default: true, desc: 'Bump minor version (default behavior)'
    class_option :version, type: :string, desc: 'Bump to a specific version (overrides all other flags)'
  end

  source_root File.expand_path('../', __FILE__)

  def verify_environment
    return if ENV['BUMP_VERSION_ALLOWED'] == 'true'

    say 'Not so fast, cowboy!', :red
    raise Thor::InvocationError, <<~MSG.strip
      This process is automated via the "Bump Version" GitHub Actions workflow.
      Trigger it from the Actions tab instead of running bin/bump_version locally.
    MSG
  end

  def bump_version
    gsub_file 'lib/turbo_form/version.rb', /^  VERSION = .*/, %(  VERSION = "#{new_version_string}")
  end

  # The npm package is published from the same tag, and the install generator
  # pins it to the gem's version. Bumping one without the other ships a pin
  # that can't resolve.
  def bump_package_version
    gsub_file 'package.json', /"version": ".*"/, %("version": "#{new_version_string}")
  end

  def echo_new_version
    say "New Gem Version is #{set_color(new_version_string, :yellow)}", :green
  end

  private

  def new_version_string
    @new_version_string ||= begin
      nv = current_version
      nv = nv.bump unless options.version?
      nv = nv.bump if options.major?
      nv.segments.fill(0, nv.segments.size, 3 - nv.segments.size).join('.')
    end
  end

  def current_version
    Gem::Version.new(
      if options.patch?
        TurboForm::VERSION + '.0'
      else
        options[:version] || TurboForm::VERSION
      end
    )
  end

  class << self
    def exit_on_failure? = true
    def banner = 'bin/bump_version [--patch|--major|--version VERSION]'
    def desc = 'Update Gem Version & Sync Example Apps'
  end
end

VersionBumper.start(ARGV) if __FILE__ == $PROGRAM_NAME
